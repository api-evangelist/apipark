{
  "opencollection": "1.0.0",
  "info": {
    "name": "APIPark AI Models Services API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Services",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.apipark.com/v1/services"
          },
          "docs": "List all API services published in the APIPark developer portal."
        },
        {
          "info": {
            "name": "Create Service",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.apipark.com/v1/services",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new API service in the APIPark developer portal."
        }
      ]
    }
  ],
  "bundled": true
}